# Azure Speech (free tier F0). Leave the key empty to use the Mac's built-in voice only.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Claude model alias used through your Claude Code login (sonnet | haiku | opus)
POOD_CLAUDE_MODEL=sonnet

# Whisper model (Hugging Face repo for mlx-whisper)
POOD_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# Where the SQLite file lives
POOD_DATA_DIR=./data

# Local port
POOD_PORT=8765
